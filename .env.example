# Set to "false" to disable new user registration (e.g. after initial setup)
ALLOW_REGISTRATION=true

# ── URLs ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_BASE_URL=http://localhost:3000
NEXT_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Your main domain (used as default short-link domain, auth origins, etc.)
NEXT_PUBLIC_APP_DOMAIN=example.com
# Bio-links subdomain (defaults to bio.NEXT_PUBLIC_APP_DOMAIN if unset)
NEXT_PUBLIC_BIO_URL=https://bio.example.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=
# Optional: read replica for lower-latency reads. Omit for single-node setups.
DATABASE_REPLICA_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://app.localhost:3000
EMAIL_VERIFICATION_CALLBACK=http://app.localhost:3000/email-verified

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Redis + QStash (Upstash) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash — used for analytics batch processing and usage cron jobs
# Get from: https://console.upstash.com/qstash
UPSTASH_QSTASH_REST_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Base URL for QStash to call cron endpoints (must be publicly reachable)
# Defaults to NEXT_PUBLIC_APP_URL if unset
CRON_BASE_URL=

# ── Analytics ─────────────────────────────────────────────────────────────────
# Shared secret for internal click event ingestion (Edge → Node.js API route)
# Generate with: openssl rand -hex 32
ANALYTICS_INGEST_SECRET=

# Secret for the /api/cron/cleanup-analytics endpoint (90-day data retention)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_CLIENT_ID=

# ── S3-Compatible Storage (image storage, e.g. MinIO, Tigris, AWS S3) ─────────
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET_NAME=my-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── API Key Auth ───────────────────────────────────────────────────────────────
# Optional: enables API key auth for POST /api/workspace/*/link
# Generate with: openssl rand -hex 32
SLUGY_API_KEY=
