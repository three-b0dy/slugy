# Set to "false" to disable new user registration (e.g. after initial setup)
ALLOW_REGISTRATION=true

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_BASE_URL=http://localhost:3000
NEXT_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ASSETS=files.example.com
NEXT_EXPIRATION_URL=http://localhost:3000
NEXT_DOT_URL="localhost:3000"

# DATABASE:(POSTGRESQL)
DATABASE_URL=
# Optional: Neon read replica. Omit for single-node personal use.
DATABASE_REPLICA_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://app.localhost:3000
EMAIL_VERIFICATION_CALLBACK=http://app.localhost:3000/email-verified

#resend:
RESEND_API_KEY=
EMAIL_FROM=

#gemini
GEMINI_API_KEY=

# upstash (Redis only — QStash removed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# tinybird
TINYBIRD_API_KEY=

GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_CLIENT_ID=

# S3-Compatible Storage (image storage, e.g. MinIO, Tigris, AWS S3)
S3_ENDPOINT=https://axwajk9f2hqy.compat.objectstorage.ap-singapore-1.oraclecloud.com
S3_REGION=us-east-1
S3_BUCKET_NAME=slugy-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Your main domain (used as default short-link domain, auth origins, etc.)
NEXT_PUBLIC_APP_DOMAIN=example.com
# Bio-links subdomain (defaults to bio.NEXT_PUBLIC_APP_DOMAIN if unset)
NEXT_PUBLIC_BIO_URL=https://bio.example.com

# Optional: enables API key auth for POST /api/workspace/*/link
# Generate with: openssl rand -hex 32
SLUGY_API_KEY=
